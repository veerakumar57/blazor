@page "/cart"
@using BlazorRecapDemo.services
@using BlazorRecapDemo.Models
@inject CartService CartService
@inject NavigationManager NavigationManager
<h3>Cart</h3>
<PageTitle>cart</PageTitle>
<div class="" >
    @foreach(var item in CartService.CartItems)
    {
        <div style="margin-top:10px">
            <span>@item.Name</span>
            <span>@item.Brand</span>
            <span>@item.Price</span>

            <button class="remove-btn" @onclick="()=>Delete(item)">Remove</button>
        </div>
        
    }
    @if (CartService.CartItems.Count > 0)
    {
        <button class="active" @onclick="NavigateToPayment">Buy Now</button>
    }else{
        <p> Please select the Card</p>
    }

    
</div>

